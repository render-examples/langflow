# Nothing is asked for on deploy.
#
# Set by the Blueprint: LANGFLOW_HOST, LANGFLOW_PORT, LANGFLOW_DATABASE_URL,
# LANGFLOW_CONFIG_DIR, LANGFLOW_SECRET_KEY (generated), LANGFLOW_AUTO_LOGIN,
# LANGFLOW_SUPERUSER, LANGFLOW_SUPERUSER_PASSWORD (generated),
# LANGFLOW_NEW_USER_IS_ACTIVE, LANGFLOW_CUSTOM_COMPONENT_ADMIN_ONLY,
# LANGFLOW_CORS_ORIGINS, DO_NOT_TRACK.
#
# Optional, add on the langflow service after deploy:
# OPENAI_API_KEY=                 # or save provider keys as global variables in the UI
# ANTHROPIC_API_KEY=
# LANGFLOW_WORKERS=1              # more workers need more memory
# LANGFLOW_LOG_LEVEL=info
# LANGFLOW_MAX_FILE_SIZE_UPLOAD=100   # MB
# Full list: https://docs.langflow.org/environment-variables
